rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(calendarId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /calendars/{calendarId} {
      // メンバーならカレンダー情報を読める
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // サインイン済みなら新しいカレンダーを作成できる（ownerId が自分自身であること）
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // メンバー追加（招待コード参加）は Cloud Function 経由で行うため、
      // クライアントからの update はメンバーのみに制限
      allow update: if isMember(calendarId);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      match /events/{eventId} {
        allow read, write: if isMember(calendarId);
      }
    }
  }
}
